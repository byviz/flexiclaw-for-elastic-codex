# Prefer ~/.config/flexiclaw/config.json for local setup. This file remains
# supported for CI or environments that manage secrets through env variables.
KIBANA_URL=https://your-kibana.example.com
ELASTICSEARCH_URL=https://your-elasticsearch.example.com
ELASTIC_AUTH_HEADER="ApiKey your-base64-encoded-api-key"

# Optional. If omitted, publish uses ELASTIC_AUTH_HEADER.
# Use a restricted key that can create/update Kibana dashboards and visualizations.
ELASTIC_DASHBOARD_AUTH_HEADER="ApiKey your-dashboard-write-key"
